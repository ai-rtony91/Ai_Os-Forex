  "validation": {
    "json_parse_required": true,
    "launcher_required": false,
    "manual_review_required": true,
    "expected_checks": [
      "JSON profile parses successfully.",
      "git diff --check passes.",
      "No launcher script is created.",
      "No startup persistence is configured.",
      "No scheduled task is configured.",
      "No broker, OANDA, API key, secret, or live trading path is enabled.",
      "Every required field has the declared type and safety value.",
      "Pane IDs are unique, pane positions are in bounds, and pane rectangles do not overlap.",
      "Every pane has a null startup command and blocks execution, persistence, and scheduled-task actions."
    ]
  },
  "notes": [
    "This is a schema-only example for terminal grid planning.",
    "It is not a launcher and does not define executable startup commands.",
    "Future implementation requires a separate approved APPLY task."
  ]
