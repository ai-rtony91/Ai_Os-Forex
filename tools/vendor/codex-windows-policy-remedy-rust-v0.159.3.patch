+    impl Respond for CoreWire {
+        fn respond(&self, request: &Request) -> ResponseTemplate {
+            let body: Value = serde_json::from_slice(&request.body).expect("actual MCP JSON-RPC");
+            let id = body.get("id").cloned().unwrap_or(Value::Null);
+            let result = match body.get("method").and_then(Value::as_str) {
+                Some("initialize") => json!({
+                    "protocolVersion": body.pointer("/params/protocolVersion").and_then(Value::as_str)
+                        .unwrap_or("2025-06-18"),
+                    "capabilities": {
+                        "tools": {},
+                        "experimental": {(STATE_KEY): {}}
+                    },
+                    "serverInfo": {"name": "owned-core-capture", "version": "0.0.0-test"}
+                }),
+                Some("notifications/initialized") => return ResponseTemplate::new(202),
+                Some("tools/list") => {
+                    let gate = self.catalog_gate.lock().unwrap().take();
+                    self.catalog_entered.notify_one();
+                    if let Some(gate) = gate {
+                        if gate.recv_timeout(BOUND).is_err() {
+                            return ResponseTemplate::new(500).set_body_json(json!({
+                                "jsonrpc": "2.0", "id": id,
+                                "error": {"code": -32603, "message": "owned catalog gate expired"}
+                            }));
+                        }
+                    }
+                    json!({"tools": [{
+                        "name": TOOL, "description": "Read the one owned harmless marker",
+                        "inputSchema": {"type": "object", "properties": {}},
+                        "annotations": {"readOnlyHint": true}
+                    }]})
+                },
+                Some("tools/call") => {
+                    assert_eq!(body.pointer("/params/name").and_then(Value::as_str), Some(TOOL));
+                    self.raw_calls.lock().unwrap().push(request.body.clone());
+                    let gate = self.response_gate.lock().unwrap().take();
+                    self.entered.notify_one();
+                    // Same dedicated wiremock responder gate pattern as the pinned
+                    // AppsTestServer, with a strict bound instead of an open wait.
+                    if let Some(gate) = gate {
+                        if gate.recv_timeout(BOUND).is_err() {
+                            return ResponseTemplate::new(500).set_body_json(json!({
+                                "jsonrpc": "2.0", "id": id,
+                                "error": {"code": -32603, "message": "owned response gate expired"}
+                            }));
+                        }
+                    }
+                    let bytes = std::fs::read(&self.marker).expect("read only owned marker");
+                    self.reads.fetch_add(1, Ordering::SeqCst);
+                    json!({
+                        "content": [],
+                        "structuredContent": {
+                            "actualMeta": body.pointer("/params/_meta").cloned().unwrap_or(Value::Null),
+                            "ownedReadBytes": bytes
+                        }
+                    })
+                }
+                Some("ping") => json!({}),
+                _ => return ResponseTemplate::new(200).set_body_json(json!({
+                    "jsonrpc": "2.0", "id": id,
+                    "error": {"code": -32601, "message": "unexpected owned MCP method"}
+                })),
+            };
+            ResponseTemplate::new(200).set_body_json(json!({
+                "jsonrpc": "2.0", "id": id, "result": result
+            }))
+        }
+    }
