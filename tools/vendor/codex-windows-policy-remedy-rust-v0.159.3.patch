+    impl CoreWire {
+        fn hold_next_response(&self) -> mpsc::Sender<()> {
+            let (release, gate) = mpsc::channel();
+            *self.response_gate.lock().unwrap() = Some(gate);
+            release
+        }
+
+        fn release_catalog(&self) -> anyhow::Result<()> {
+            self.catalog_release.lock().unwrap().take()
+                .ok_or_else(|| anyhow::anyhow!("owned catalog release absent"))?
+                .send(()).map_err(|_| anyhow::anyhow!("release actual old catalog"))
+        }
+
+        fn calls(&self) -> usize {
+            self.raw_calls.lock().unwrap().len()
+        }
+
+        fn call_body(&self, index: usize) -> Value {
+            serde_json::from_slice(&self.raw_calls.lock().unwrap()[index]).unwrap()
+        }
+    }
