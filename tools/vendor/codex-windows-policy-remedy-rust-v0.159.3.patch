+// HELD vendor candidate: source-produced metadata for the direct no-model route.
+fn direct_call_meta_with_sandbox_state(
+    meta: Option<serde_json::Value>,
+    state: Option<serde_json::Value>,
+) -> anyhow::Result<Option<serde_json::Value>> {
+    let had_meta = meta.is_some();
+    let mut map = match meta {
+        Some(serde_json::Value::Object(map)) => map,
+        None => serde_json::Map::new(),
+        Some(_) => anyhow::bail!("direct MCP request _meta must be a JSON object"),
+    };
+    let key = codex_mcp::MCP_SANDBOX_STATE_META_CAPABILITY;
+    match state {
+        Some(state) => { map.insert(key.to_string(), state); }
+        None if map.contains_key(key) => {
+            anyhow::bail!("caller-supplied sandbox state is not a genuine producer export")
+        }
+        None => {}
+    }
+    Ok((had_meta || !map.is_empty()).then_some(serde_json::Value::Object(map)))
+}
