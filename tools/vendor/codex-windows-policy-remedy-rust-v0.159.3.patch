+    #[tokio::test]
+    async fn direct_call_sandbox_state_target_only_does_not_wait_for_pending_optional_server() -> Result<()> {
+        let gate = Arc::new(Notify::new());
+        let unrelated = start_owned_server(Capture {
+            initialize_gate: Some(Arc::clone(&gate)), ..Default::default()
+        }).await?;
+        let server = start_owned_server(Capture { capability: true, ..Default::default() }).await?;
+        let extra = format!(
+            "[mcp_servers.unrelated]\nurl = {:?}\nrequired = false\nstartup_timeout_sec = 12\n",
+            unrelated.url
+        );
+        let mut app = start_owned_app(config_for(&server.url, "", &format!(
+            "\n{extra}"
+        ))).await?;
+        timeout(CALL_BOUND, async {
+            while unrelated.capture.initializes.load(Ordering::SeqCst) == 0 {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        }).await?;
+        let initialized_before = unrelated.capture.initializes.load(Ordering::SeqCst);
+        assert_eq!(unrelated.capture.catalogs.load(Ordering::SeqCst), 0);
+        let actual = call(&mut app, "target", "capture", None, None).await?;
+        typed_state(&actual)?;
+        assert_eq!(unrelated.capture.initializes.load(Ordering::SeqCst), initialized_before);
+        assert_eq!(unrelated.capture.catalogs.load(Ordering::SeqCst), 0);
+        assert_eq!(call_count(&unrelated), 0);
+        gate.notify_waiters();
+        // This witnesses no additional startup/no unrelated wait, not zero eager
+        // startup: eager initialization may already precede the direct request.
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn direct_call_sandbox_state_configured_timeout_bounds_real_transport() -> Result<()> {
+        let server = start_owned_server(Capture { capability: true, ..Default::default() }).await?;
+        let mut app = start_owned_app(config_for(&server.url, "", "tool_timeout_sec = 0.05")).await?;
+        let started = tokio::time::Instant::now();
+        let error = reject(&mut app, "target", "capture", None, Some(json!({"delay_ms": 1500}))).await?;
+        assert!(error.contains("timed out") || error.contains("timeout"), "{error}");
+        assert!(started.elapsed() < CALL_BOUND);
+        assert_eq!(call_count(&server), 1);
+        let actual = call(&mut app, "target", "capture", Some(json!({"afterTimeout": true})), None).await?;
+        assert_eq!(actual["afterTimeout"], true);
+        assert_eq!(call_count(&server), 2);
+        // Outer process ownership, descendant cleanup, and explicit requested
+        // timeout are separate rows; this RPC does not expose requested_timeout.
+        Ok(())
+    }
