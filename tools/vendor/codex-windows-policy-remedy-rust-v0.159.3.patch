+    async fn owned_core(configured_timeout: Option<Duration>, hold_catalog: bool) -> anyhow::Result<OwnedCore> {
+        let home = TempDir::new()?;
+        let workspace = TempDir::new()?;
+        let marker = workspace.path().join("owned-marker");
+        std::fs::write(&marker, b"owned-harmless-marker")?;
+        let wire = CoreWire {
+            marker, raw_calls: Default::default(), reads: Default::default(),
+            entered: Default::default(), response_gate: Default::default(),
+            catalog_entered: Default::default(), catalog_gate: Default::default(),
+            catalog_release: Default::default(),
+        };
+        if hold_catalog {
+            let (release, gate) = mpsc::channel();
+            *wire.catalog_gate.lock().unwrap() = Some(gate);
+            *wire.catalog_release.lock().unwrap() = Some(release);
+        }
+        let server = MockServer::start().await;
+        Mock::given(method("POST")).and(path("/mcp"))
+            .respond_with(wire.clone()).mount(&server).await;
+        let url = format!("{}/mcp", server.uri());
+        let home_path = AbsolutePathBuf::try_from(home.path().to_path_buf())?;
+        let cwd = AbsolutePathBuf::try_from(workspace.path().to_path_buf())?;
+        let (session, turn, events) =
+            make_session_and_context_with_auth_and_config_and_rx(
+                CodexAuth::from_api_key("owned-fixture-only-not-a-real-key"),
+                Vec::new(),
+                move |config| {
+                    config.codex_home = home_path;
+                    config.cwd = cwd;
+                    config.analytics_enabled = Some(false);
+                    let mut server = json!({"url": url});
+                    if let Some(bound) = configured_timeout {
+                        server["tool_timeout_sec"] = json!(bound.as_secs_f64());
+                    }
+                    config.mcp_servers.set(HashMap::from([(
+                        SERVER.to_string(),
+                        serde_json::from_value(server).expect("actual configured MCP type"),
+                    )])).expect("owned server is admitted by fixture configuration");
+                },
+            ).await;
+        session.refresh_mcp_if_dirty().await;
+        let runtime = Arc::clone(&session.services.mcp_runtime);
+        let (tx_sub, _rx_sub) = async_channel::bounded(1);
+        let io = SessionIo {
+            tx_sub, rx_event: events,
+            agent_status: watch::channel(AgentStatus::PendingInit).1,
+            session_loop_termination: crate::session::completed_session_loop_termination(),
+        };
+        // Constructor-only startup metadata. The producer ignores this fixture
+        // record and reads the real current runtime's captured policy instead.
+        let event = SessionConfiguredEvent {
+            session_id: codex_protocol::SessionId::from(session.thread_id),
+            thread_id: session.thread_id,
+            forked_from_id: None, parent_thread_id: None, thread_source: None,
+            thread_name: None, model: "owned-uninvoked-model".to_string(),
+            model_provider_id: "owned-uninvoked-provider".to_string(), service_tier: None,
+            approval_policy: turn.config.permissions.approval_policy.value(),
+            approvals_reviewer: turn.config.approvals_reviewer,
+            permission_profile: turn.config.permissions.effective_permission_profile(),
+            active_permission_profile: None, cwd: turn.config.cwd.clone(),
+            reasoning_effort: None, initial_messages: None, network_proxy: None,
+            rollout_path: None,
+        };
+        let thread = Arc::new(CodexThread::new(
+            Arc::clone(&session), io, ThreadStartupMetadata::from(&event), None, SessionSource::Exec,
+        ));
+        Ok(OwnedCore { thread, session, runtime, _home: home, workspace, _server: server, wire })
+    }
