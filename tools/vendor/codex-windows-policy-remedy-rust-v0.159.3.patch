+        -> anyhow::Result<()>
+    {
+        let owned = owned_core(None, false).await?;
+        let authority = PreparedMcpCall::prepare_direct(&owned.runtime, SERVER, TOOL).await?
+            .ok_or_else(|| anyhow::anyhow!("real captured authority unavailable"))?;
+        let config = owned.runtime.current_config().unwrap();
+        let release = owned.wire.hold_next_response();
+        let entered = owned.wire.entered.notified();
+        tokio::pin!(entered);
+        entered.as_mut().enable();
+        let pending = {
+            let thread = Arc::clone(&owned.thread);
+            tokio::spawn(async move {
+                thread.call_mcp_tool(SERVER, TOOL, None,
+                    Some(json!({"rootRequestNonce": "owned-inflight-old"}))).await
+            })
+        };
+        timeout(BOUND, entered).await?;
+        assert_eq!(owned.wire.calls(), 1);
+        assert_eq!(owned.wire.reads.load(Ordering::SeqCst), 0);
+        let original_request = owned.wire.call_body(0);
+        assert_genuine_fields(&owned, &authority, &original_request["params"]["_meta"])?;
+        assert!(authority.is_current_in(&owned.runtime));
+        owned.runtime.reconnect_on_next_refresh();
+        timeout(BOUND, owned.runtime.replace(input_for(&owned, Arc::clone(&config)).await)).await?;
+        assert!(Arc::ptr_eq(&config, &owned.runtime.current_config().unwrap()));
+        assert!(!authority.is_current_in(&owned.runtime),
+            "same config Arc plus failed two-part identity witnesses fresh actual connections");
+        release.send(()).map_err(|_| anyhow::anyhow!("release actual old response"))?;
+        let error = timeout(BOUND, pending).await??.expect_err(
+            "actual CodexThread must reject the old state-bearing response after publication");
+        assert!(error.to_string().contains("sandbox-state binding changed during capture"), "{error:#}");
+        assert_eq!(owned.wire.reads.load(Ordering::SeqCst), 1);
+        // This real old export/read is failure evidence. Do not relabel it current.
+        assert_eq!(owned.wire.call_body(0), original_request);
+        let current = PreparedMcpCall::prepare_direct(&owned.runtime, SERVER, TOOL).await?
+            .ok_or_else(|| anyhow::anyhow!("fresh real control unavailable"))?;
+        let fresh = timeout(BOUND, owned.thread.call_mcp_tool(SERVER, TOOL, None,
+            Some(json!({"rootRequestNonce": "owned-inflight-fresh"})))).await??;
+        let fresh = fresh.structured_content.ok_or_else(|| anyhow::anyhow!("fresh result absent"))?;
+        assert_genuine_fields(&owned, &current, &fresh["actualMeta"])?;
+        assert_eq!(fresh["actualMeta"]["rootRequestNonce"], "owned-inflight-fresh");
+        assert_eq!(owned.wire.calls(), 2);
+        assert_eq!(owned.wire.reads.load(Ordering::SeqCst), 2);
+        drop(authority);
+        owned.close().await?;
+        Ok(())
+    }
