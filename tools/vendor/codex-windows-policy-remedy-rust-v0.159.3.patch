+    #[tokio::test]
+    async fn direct_call_sandbox_state_refresh_uses_new_configured_server() -> Result<()> {
+        let old = start_owned_server(Capture { capability: true, ..Default::default() }).await?;
+        let new = start_owned_server(Capture { capability: true, ..Default::default() }).await?;
+        let mut app = start_owned_app(config_for(&old.url, "", "")).await?;
+        let before = call(&mut app, "target", "capture", Some(json!({"phase": "before"})), None).await?;
+        typed_state(&before)?;
+        std::fs::write(app.codex_home.path().join("config.toml"), config_for(&new.url, "", ""))?;
+        let refresh = app.app.send_raw_request("config/mcpServer/reload", None).await?;
+        let _: Value = timeout(CALL_BOUND, app.app.read_response(refresh)).await??;
+        let after = call(&mut app, "target", "capture", Some(json!({"phase": "after"})), None).await?;
+        typed_state(&after)?;
+        assert_eq!(after["threadId"], app.thread_id);
+        assert_eq!(call_count(&old), 1);
+        assert_eq!(call_count(&new), 1);
+        assert_eq!(new.capture.calls.lock().unwrap()[0]["phase"], "after");
+        // This does not assert same-config Arc identity or an in-flight barrier.
+        Ok(())
+    }
