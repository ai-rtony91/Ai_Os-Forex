+    #[tokio::test]
+    async fn direct_call_sandbox_state_rejects_nonobject_wire_metadata_before_transport() -> Result<()> {
+        for capability in [false, true] {
+            let server = start_owned_server(Capture { capability, ..Default::default() }).await?;
+            let mut app = start_owned_app(config_for(&server.url, "", "")).await?;
+            for invalid in [json!(false), json!(17), json!("bad"), json!([])] {
+                let error = reject(&mut app, "target", "capture", Some(invalid.clone()), None).await?;
+                assert!(error.contains("_meta must be a JSON object"), "{invalid}: {error}");
+                assert_eq!(call_count(&server), 0);
+            }
+            // Option<Value> maps explicit wire null to absent. The core helper's
+            // Some(Null) rejection belongs to its existing focused unit test.
+            let actual = call(&mut app, "target", "capture", Some(Value::Null), None).await?;
+            assert_eq!(actual["threadId"], app.thread_id);
+            assert_eq!(actual.get(STATE_KEY).is_some(), capability);
+        }
+        Ok(())
+    }
