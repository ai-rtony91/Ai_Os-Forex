+        -> anyhow::Result<()>
+    {
+        for (configured_ms, requested_ms) in [(50, 500), (500, 50)] {
+            let owned = owned_core(Some(Duration::from_millis(configured_ms)), false).await?;
+            let current = PreparedMcpCall::prepare_direct(&owned.runtime, SERVER, TOOL).await?
+                .ok_or_else(|| anyhow::anyhow!("real timeout capture unavailable"))?;
