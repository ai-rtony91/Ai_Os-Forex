+                }
+            }).await?;
+            assert_eq!(owned.wire.reads.load(Ordering::SeqCst), 1);
+            owned.close().await?;
+        }
+        Ok(())
+    }
+    #[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+    async fn direct_call_sandbox_state_publication_changes_during_target_capture_before_wire()
+        -> anyhow::Result<()>
+    {
+        let owned = owned_core(None, true).await?;
+        timeout(BOUND, owned.wire.catalog_entered.notified()).await?;
+        let old_config = owned.runtime.current_config().unwrap();
+        let mut pending = Box::pin(owned.thread.call_mcp_tool(SERVER, TOOL, None,
+            Some(json!({"rootRequestNonce": "owned-before-state-capture"}))));
+        // The session's refresh was settled by owned_core. With its auth and
+        // environments unchanged and no submitted turn, the target startup
+        // catalog is the first pending authority input in this actual call.
+        assert!(futures::poll!(pending.as_mut()).is_pending());
+        let mut next_config = (*old_config).clone();
+        next_config.use_legacy_landlock = !old_config.use_legacy_landlock;
+        let next_config = Arc::new(next_config);
+        owned.runtime.reconnect_on_next_refresh();
+        timeout(BOUND, owned.runtime.replace(
+            input_for(&owned, Arc::clone(&next_config)).await,
+        )).await?;
+        assert!(!Arc::ptr_eq(&old_config, &owned.runtime.current_config().unwrap()));
+        owned.wire.release_catalog()?;
+        let error = timeout(BOUND, pending).await?
+            .expect_err("actual capture must reject replaced authority before state/transport");
+        assert!(error.to_string().contains("publication changed during capture"), "{error:#}");
+        assert_eq!(owned.wire.calls(), 0);
+        assert_eq!(owned.wire.reads.load(Ordering::SeqCst), 0);
+        let current = PreparedMcpCall::prepare_direct(&owned.runtime, SERVER, TOOL).await?
+            .ok_or_else(|| anyhow::anyhow!("fresh capture valid control absent"))?;
+        let result = timeout(BOUND, owned.thread.call_mcp_tool(SERVER, TOOL, None,
+            Some(json!({"rootRequestNonce": "owned-after-capture-replacement"})))).await??;
+        let result = result.structured_content.ok_or_else(|| anyhow::anyhow!("current result absent"))?;
+        assert_genuine_fields(&owned, &current, &result["actualMeta"])?;
