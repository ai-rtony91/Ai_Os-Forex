+#[cfg(test)]
+mod direct_call_sandbox_state_meta_tests {
+    use super::direct_call_meta_with_sandbox_state;
+    use serde_json::json;
+
+    #[test]
+    fn producer_state_overwrites_caller_value_preserving_other_metadata() {
+        let key = codex_mcp::MCP_SANDBOX_STATE_META_CAPABILITY;
+        let mut input = json!({"threadId":"owned-thread", "other":{"stable":true}});
+        input.as_object_mut().unwrap().insert(key.into(), json!({"fabricated":true}));
+        let original = input.clone();
+        let produced = json!({"captured_profile_marker":"unit-only-not-enforcement"});
+        let actual = direct_call_meta_with_sandbox_state(Some(input.clone()), Some(produced.clone())).unwrap().unwrap();
+        assert_eq!(actual[key], produced);
+        assert_eq!(actual["threadId"], original["threadId"]);
+        assert_eq!(actual["other"], original["other"]);
+        assert_eq!(input, original);
+    }
+
+    #[test]
+    fn non_object_metadata_is_rejected_even_with_producer_state() {
+        for value in [json!(null), json!(false), json!(17), json!("bad"), json!([])] {
+            assert!(direct_call_meta_with_sandbox_state(Some(value), Some(json!({}))).is_err());
+        }
+    }
+
+    #[test]
+    fn unsupported_producer_cannot_forward_a_caller_state() {
+        let key = codex_mcp::MCP_SANDBOX_STATE_META_CAPABILITY;
+        let mut input = json!({});
+        input.as_object_mut().unwrap().insert(key.into(), json!({"fabricated":true}));
+        assert!(direct_call_meta_with_sandbox_state(Some(input), None).is_err());
+    }
+
+    #[test]
+    fn non_opted_in_metadata_without_state_is_preserved() {
+        let original = json!({"threadId":"owned-thread", "request":"nonce"});
+        assert_eq!(direct_call_meta_with_sandbox_state(Some(original.clone()), None).unwrap(), Some(original));
+        assert_eq!(direct_call_meta_with_sandbox_state(None, None).unwrap(), None);
+        assert_eq!(direct_call_meta_with_sandbox_state(Some(json!({})), None).unwrap(), Some(json!({})));
+    }
+}
