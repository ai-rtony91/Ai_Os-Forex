+        let router = Router::new().nest_service("/mcp", service);
+        let task = tokio::spawn(async move {
+            let _ = axum::serve(listener, router).await;
+        });
+        Ok(OwnedServer { url: format!("http://{address}/mcp"), capture, task })
+    }
+
+    fn config_for(url: &str, extra_root: &str, extra_target: &str) -> String {
+        // Only owned loopback fixtures are configured. No auth files are copied.
+        format!(
+            "sandbox_mode = \"read-only\"\napproval_policy = \"never\"\n\
+             mcp_optional_startup_grace_ms = 0\n{extra_root}\n\
+             [mcp_servers.target]\nurl = {url:?}\n{extra_target}\n"
+        )
+    }
+
+    // Declare the app first so its Drop runs before the owned directories vanish.
+    struct OwnedApp {
+        app: TestAppServer,
+        thread_id: String,
+        codex_home: TempDir,
+        workspace: TempDir,
+    }
+
+    async fn start_owned_app(config: String) -> Result<OwnedApp> {
+        let codex_home = TempDir::new()?;
+        let workspace = TempDir::new()?;
+        std::fs::write(codex_home.path().join("config.toml"), config)?;
+        let mut app = TestAppServer::builder()
+            .with_codex_home(codex_home.path())
+            .without_auto_env()
+            .without_managed_config()
+            .build_initialized_with_timeout(DEFAULT_TIMEOUT)
+            .await?;
+        // Existing RPC, same typed ThreadStartResponse as the owning module.
+        let id = app.send_raw_request("thread/start", Some(json!({
+            "cwd": workspace.path().to_string_lossy(),
+            "sandbox": "read-only",
+            "approvalPolicy": "never",
+            "ephemeral": true
+        }))).await?;
+        let response: ThreadStartResponse =
+            timeout(DEFAULT_TIMEOUT, app.read_response(id)).await??;
+        Ok(OwnedApp { app, thread_id: response.thread.id, codex_home, workspace })
+    }
+
+    async fn send(
+        app: &mut OwnedApp,
+        server: &str,
+        tool: &str,
+        meta: Option<Value>,
+        arguments: Option<Value>,
+    ) -> Result<i64> {
+        Ok(app.app.send_mcp_server_tool_call_request(McpServerToolCallParams {
+            thread_id: app.thread_id.clone(),
+            server: server.to_string(),
+            tool: tool.to_string(),
+            arguments,
+            meta,
+        }).await?)
+    }
+
+    async fn call(
+        app: &mut OwnedApp,
+        server: &str,
+        tool: &str,
+        meta: Option<Value>,
+        arguments: Option<Value>,
+    ) -> Result<Value> {
+        let id = send(app, server, tool, meta, arguments).await?;
+        let response: McpServerToolCallResponse =
+            timeout(CALL_BOUND, app.app.read_response(id)).await??;
+        response.structured_content.ok_or_else(|| anyhow::anyhow!("owned capture response missing"))
+    }
+
+    async fn reject(
+        app: &mut OwnedApp,
+        server: &str,
+        tool: &str,
+        meta: Option<Value>,
+        arguments: Option<Value>,
+    ) -> Result<String> {
+        let id = send(app, server, tool, meta, arguments).await?;
+        let error = timeout(CALL_BOUND, app.app.read_stream_until_error_message(RequestId::Integer(id))).await??;
+        Ok(error.error.message)
+    }
+
+    fn call_count(server: &OwnedServer) -> usize {
+        server.capture.calls.lock().unwrap().len()
+    }
+
+    fn typed_state(meta: &Value) -> Result<codex_mcp::SandboxState> {
+        serde_json::from_value(
+            meta.get(STATE_KEY).cloned()
+                .ok_or_else(|| anyhow::anyhow!("genuine state absent from actual wire metadata"))?
+        ).map_err(Into::into)
+    }
+
+    #[tokio::test]
+    async fn direct_call_sandbox_state_advertised_wire_is_typed_and_thread_bound() -> Result<()> {
+        let server = start_owned_server(Capture { capability: true, ..Default::default() }).await?;
+        let mut app = start_owned_app(config_for(&server.url, "", "")).await?;
+        let actual = call(&mut app, "target", "capture", Some(json!({
+            "rootRequestNonce": "owned-advertised-control",
+            "threadId": "caller-must-not-select-the-thread"
+        })), None).await?;
+        let state = typed_state(&actual)?;
+        assert_eq!(state.permission_profile, codex_protocol::models::PermissionProfile::read_only());
+        assert_eq!(
+            state.sandbox_cwd,
+            codex_utils_path_uri::PathUri::from_host_native_path(app.workspace.path())?
+        );
+        assert_eq!(actual["rootRequestNonce"], "owned-advertised-control");
+        assert_eq!(actual["threadId"], app.thread_id);
+        assert_eq!(call_count(&server), 1);
+        assert_eq!(server.capture.calls.lock().unwrap()[0], actual);
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn direct_call_sandbox_state_replaces_fabricated_state_and_preserves_input() -> Result<()> {
+        let server = start_owned_server(Capture { capability: true, ..Default::default() }).await?;
+        let mut app = start_owned_app(config_for(&server.url, "", "")).await?;
+        let mut input = json!({"rootRequestNonce": "owned-overwrite", "other": {"stable": [1, true]}});
+        input.as_object_mut().unwrap().insert(STATE_KEY.into(), json!({"fabricated": true}));
+        let original = input.clone();
+        let actual = call(&mut app, "target", "capture", Some(input.clone()), None).await?;
+        let state = typed_state(&actual)?;
+        assert_eq!(state.permission_profile, codex_protocol::models::PermissionProfile::read_only());
+        assert_ne!(actual[STATE_KEY], original[STATE_KEY]);
+        assert_eq!(actual["other"], original["other"]);
+        assert_eq!(actual["rootRequestNonce"], original["rootRequestNonce"]);
+        assert_eq!(actual["threadId"], app.thread_id);
+        assert_eq!(input, original);
+        assert_eq!(call_count(&server), 1);
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn direct_call_sandbox_state_opt_out_preserves_raw_and_rejects_reserved() -> Result<()> {
+        let server = start_owned_server(Capture::default()).await?;
+        let mut app = start_owned_app(config_for(&server.url, "", "")).await?;
+        let actual = call(&mut app, "target", "capture", Some(json!({"ordinary": [7, "raw"]})), None).await?;
+        assert_eq!(actual["ordinary"], json!([7, "raw"]));
+        assert_eq!(actual["threadId"], app.thread_id);
+        assert!(actual.get(STATE_KEY).is_none());
+        let before = call_count(&server);
+        let mut fabricated = json!({"ordinary": true});
+        fabricated.as_object_mut().unwrap().insert(STATE_KEY.into(), json!({"fabricated": true}));
+        let error = reject(&mut app, "target", "capture", Some(fabricated), None).await?;
+        assert!(error.contains("caller-supplied sandbox state"), "{error}");
+        assert_eq!(call_count(&server), before);
+        Ok(())
+    }
