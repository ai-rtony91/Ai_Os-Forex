{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-os.local/schemas/aios/orchestration/APPLY_APPROVAL_GATE_SCHEMA.v2",
  "title": "AI_OS Apply Approval Gate Schema",
  "description": "Versioned AI_OS apply approval gate schema. v2 records bind the complete execution scope and remain subject to Human Owner approval and runtime timing checks.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_id",
    "approved_by_human"
  ],
  "anyOf": [
    {
      "required": [
        "approval_gate_id"
      ]
    },
    {
      "required": [
        "gate_id"
      ]
    }
  ],
  "properties": {
    "approval_gate_id": {
      "type": "string"
    },
    "gate_id": {
      "type": "string"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "approval_id": {
      "type": "string"
    },
    "approval_status": {
      "type": "string"
    },
    "gate_status": {
      "type": "string"
    },
    "approved_by_human": {
      "type": "boolean"
    },
    "requested_mode": {
      "type": "string"
    },
    "approved_mode": {
      "type": "string"
    },
    "mode_allowed": {
      "type": "string"
    },
    "risk_level": {
      "type": "string"
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validator_chain_required": {
      "type": "boolean"
    },
    "validator_chain_passed": {
      "type": "boolean"
    },
    "commit_package_required": {
      "type": "boolean"
    },
    "push_blocked_until_final_review": {
      "type": "boolean"
    },
    "scope_match": {
      "type": "boolean"
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "approval_timestamp_placeholder": {
      "type": [
        "string",
        "null"
      ]
    },
    "checked_at": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "AIOS_HUMAN_OWNER_APPROVAL_PAYLOAD.v2"
    },
    "purpose": {
      "type": "string",
      "const": "AIOS_APPLY_APPROVAL_RUNTIME_ADMISSION"
    },
    "algorithm": {
      "type": "string",
      "const": "HMAC-SHA256"
    },
    "request_id": {"type": "string", "minLength": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "owner_identity": {"type": "string", "const": "Anthony, Human Owner"},
    "key_id": {"type": ["string", "null"]},
    "key_version": {"type": "integer", "minimum": 0},
    "approval_nonce": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "approval_timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
    "not_before_utc": {"type": "string", "format": "date-time"},
    "latest_entry_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "closure_reserve_hours": {"type": "number", "minimum": 0},
    "worker": {"type": "string", "minLength": 1},
    "lane": {"type": "string", "minLength": 1},
    "worktree": {"type": "string", "minLength": 1},
    "validator_chain": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "source_hashes": {"type": "object"},
    "data_hashes": {"type": "object"},
    "strategy_identity": {"type": "object"},
    "cost_identity": {"type": "object"},
    "trial_allocation": {"type": "object"},
    "resource_limits": {"type": "object"},
    "capabilities": {"type": "object"},
    "resume_policy": {"type": "object"}
  }
}
