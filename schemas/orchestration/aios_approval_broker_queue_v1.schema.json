{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios.approval_broker_queue.v1",
  "title": "AIOS Approval Broker Queue V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "generated_status",
    "continue_unblocked_preparation",
    "pending_approvals",
    "resumable_phases",
    "blocked_phases",
    "rejected_bundles",
    "expired_bundles",
    "problems"
  ],
  "properties": {
    "schema": {"const": "aios.approval_broker_queue.v1"},
    "mode": {"const": "NON_AUTHORITATIVE_APPROVAL_ROUTER"},
    "generated_status": {
      "enum": [
        "CONTINUE_AUTONOMOUSLY",
        "PREPARE_BEHIND_GATE",
        "RESUME_AUTHORIZED",
        "BLOCKED",
        "REJECTED",
        "EXPIRED"
      ]
    },
    "continue_unblocked_preparation": {"const": true},
    "pending_approvals": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/pendingApproval"}
    },
    "resumable_phases": {"$ref": "#/$defs/phaseList"},
    "blocked_phases": {"$ref": "#/$defs/phaseList"},
    "rejected_bundles": {"$ref": "#/$defs/bundleList"},
    "expired_bundles": {"$ref": "#/$defs/bundleList"},
    "problems": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "bundleId": {
      "enum": [
        "OWNER-BUNDLE-1-POLICY",
        "OWNER-BUNDLE-2-DEVICE-IDENTITY",
        "OWNER-BUNDLE-3-RUNTIME-SECRETS",
        "OWNER-BUNDLE-4-LOCATION-PRIVACY"
      ]
    },
    "phaseList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 17}
    },
    "bundleList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/bundleId"}
    },
    "pendingApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "title",
        "phases",
        "owner_actions",
        "state",
        "protected_action_blocked",
        "continue_unblocked_preparation",
        "receipt_binding_requirements"
      ],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/bundleId"},
        "title": {"type": "string", "minLength": 1},
        "phases": {"$ref": "#/$defs/phaseList"},
        "owner_actions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "state": {"const": "PENDING_TRUSTED_DECISION"},
        "protected_action_blocked": {"const": true},
        "continue_unblocked_preparation": {"const": true},
        "receipt_binding_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
