{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.local/schemas/orchestration/aios_risk_scored_command_gating_model_v1.schema.json",
  "title": "AIOS Risk-Scored Command Gating Model V1",
  "description": "Declarative Phase 11 fail-closed design; no operational authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "record_id",
    "phase",
    "state",
    "authority_state",
    "issued_at",
    "expires_at",
    "action_binding",
    "subject_reference",
    "provenance",
    "integrity_reference"
  ],
  "properties": {
    "record_version": {
      "const": "aios.risk_scored_command_gating_model.v1"
    },
    "record_id": {
      "$ref": "#/$defs/opaqueIdentifier"
    },
    "phase": {
      "const": 11
    },
    "state": {
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH",
        "CRITICAL",
        "UNKNOWN",
        "BLOCKED"
      ]
    },
    "authority_state": {
      "const": "BLOCKED"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "action_binding": {
      "$ref": "#/$defs/opaqueIdentifier"
    },
    "subject_reference": {
      "$ref": "#/$defs/opaqueIdentifier"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sanitization_state"
      ],
      "properties": {
        "source": {
          "enum": [
            "DECLARATIVE_DESIGN",
            "SANITIZED_EVIDENCE",
            "UNKNOWN"
          ]
        },
        "sanitization_state": {
          "enum": [
            "SANITIZED",
            "REDACTED",
            "QUARANTINED"
          ]
        }
      }
    },
    "integrity_reference": {
      "$ref": "#/$defs/opaqueIdentifier"
    }
  },
  "$defs": {
    "opaqueIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{7,127}$"
    }
  },
  "x-aios-phase": 11,
  "x-aios-phase-name": "Risk-Scored Command Gating Model",
  "x-aios-owner-authority": "POLICY_ACCEPTANCE",
  "x-aios-owner-bundle": "OWNER-BUNDLE-1-POLICY",
  "x-aios-preparation-mode": "PREPARE_BEHIND_GATE",
  "x-aios-protected-transition": "BLOCKED",
  "x-aios-operational-capability": false
}
