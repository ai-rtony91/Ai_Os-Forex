{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios_p1_eurusd_market_history_v1.schema.json",
  "title": "AIOS P1 sanitized EUR_USD M5 market history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_type", "provenance", "broker_label", "environment", "instrument", "granularity", "requested_count", "returned_count", "first_observed_at_utc", "last_observed_at_utc", "candles", "source_status", "stale_status", "read_only", "complete", "broker_write_performed", "credentials_persisted", "account_identifier_included", "raw_payload_included", "order_submission_allowed", "demo_execution_allowed", "live_execution_allowed", "money_movement_allowed"],
  "properties": {
    "schema": {"const": "AIOS_P1_EURUSD_MARKET_HISTORY.v1"}, "evidence_type": {"const": "SANITIZED_CANDLE_HISTORY"},
    "provenance": {"const": "GENUINE_OBSERVED_MARKET_DATA"}, "broker_label": {"const": "OANDA"}, "environment": {"const": "PRACTICE"},
    "instrument": {"const": "EUR_USD"}, "granularity": {"const": "M5"}, "requested_count": {"type": "integer", "minimum": 1},
    "returned_count": {"type": "integer", "minimum": 1}, "first_observed_at_utc": {"type": "string", "format": "date-time"},
    "last_observed_at_utc": {"type": "string", "format": "date-time"}, "source_status": {"const": "VALID"}, "stale_status": {"const": "VALID"},
    "read_only": {"const": true}, "complete": {"const": true}, "broker_write_performed": {"const": false}, "credentials_persisted": {"const": false},
    "account_identifier_included": {"const": false}, "raw_payload_included": {"const": false}, "order_submission_allowed": {"const": false},
    "demo_execution_allowed": {"const": false}, "live_execution_allowed": {"const": false}, "money_movement_allowed": {"const": false},
    "candles": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["observed_at_utc", "open", "high", "low", "close", "complete"], "properties": {
        "observed_at_utc": {"type": "string", "format": "date-time"}, "open": {"type": "number", "exclusiveMinimum": 0},
        "high": {"type": "number", "exclusiveMinimum": 0}, "low": {"type": "number", "exclusiveMinimum": 0},
        "close": {"type": "number", "exclusiveMinimum": 0}, "volume": {"type": "number", "minimum": 0}, "complete": {"const": true}}}}
  }
}
